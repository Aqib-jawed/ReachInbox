# ==========================================
# ReachInbox Email Scheduler Environment Variables
# Single source of truth for all configurations
# ==========================================

# ------------------------------------------
# Server & Network Configuration
# ------------------------------------------
# Port for the Express API server
PORT=4000
# Environment mode: development, test, or production
NODE_ENV=development

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# PostgreSQL connection string for Prisma/Drizzle ORM
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox?schema=public
# PostgreSQL credentials used by docker-compose
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox

# ------------------------------------------
# Queue & Cache Configuration (Redis + BullMQ)
# ------------------------------------------
# Redis connection URL for BullMQ job queues and rate limit counters
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# Worker & Scheduler Configuration
# ------------------------------------------
# Number of parallel jobs a worker instance can process concurrently
WORKER_CONCURRENCY=5
# Minimum enforced delay in milliseconds between sequential emails to avoid bursting
MIN_DELAY_MS=2000
# Maximum emails a single sender can send per 1-hour rolling/fixed window before rescheduling
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# ------------------------------------------
# Search Engine (Elasticsearch)
# ------------------------------------------
# Elasticsearch node endpoint for full-text email indexing & search
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------
# SMTP / Email Sandbox (Ethereal Email)
# ------------------------------------------
# Default Ethereal sandbox username (created via ethereal.email or nodemailer.createTestAccount)
ETHEREAL_USER=your_ethereal_user@ethereal.email
# Default Ethereal sandbox password
ETHEREAL_PASS=your_ethereal_password

# ------------------------------------------
# Slack OAuth & Notifications
# ------------------------------------------
# Slack OAuth app Client ID for the "Connect Slack" flow
SLACK_CLIENT_ID=placeholder_slack_client_id
# Slack OAuth app Client Secret
SLACK_CLIENT_SECRET=placeholder_slack_client_secret
# Slack OAuth Redirect URI callback endpoint
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
# Slack Webhook URL (fallback / direct notification channel)
SLACK_WEBHOOK_URL=https://hooks_slack_placeholder_url

# ------------------------------------------
# Google OAuth 2.0 (Authentication)
# ------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=placeholder_google_client_id.apps.googleusercontent.com
# Google Cloud Console OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
# Google OAuth 2.0 Redirect URI callback endpoint
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ------------------------------------------
# Frontend & NextAuth Session Configuration
# ------------------------------------------
# Secret used for signing session JWT tokens / cookies
NEXTAUTH_SECRET=super_secret_jwt_encryption_key_change_in_production
# Base URL for Next.js frontend
NEXTAUTH_URL=http://localhost:3000
